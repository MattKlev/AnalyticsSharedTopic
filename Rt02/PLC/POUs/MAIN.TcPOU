<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{86f2f4f3-887d-4133-be4a-6e34a719ffcf}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	Mover  : ST_Mover;
	Active : BOOL;					// "Mover Active" - set TRUE via ADS, the PLC resets it when the arc is finished
END_VAR
VAR
	ActiveLast : BOOL;
	Angle      : LREAL;				// current angle [rad]
	AngleStep  : LREAL;				// angle increment per PLC cycle [rad]
END_VAR
VAR CONSTANT
	cPi         : LREAL := 3.14159265358979;
	cBtn        : UDINT := 1234;	// BTN the Analytics Logger condition is waiting for
	cCenterX    : LREAL := 0.0;
	cCenterY    : LREAL := 0.0;
	cRadius     : LREAL := 10.0;
	cStartAngle : LREAL := cPi;		// Rt02 draws the second half: 180..360 deg
	cEndAngle   : LREAL := 2.0 * cPi;
	cArcTime    : LREAL := 5.0;		// time to draw the half circle [s]
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Mover.ControllerID:=2; //Who is controlling the mover - diagnostics on the scope, using dynamic sytle.

IF Active THEN
	IF NOT ActiveLast THEN
		// Rising edge: start the arc. Task cycle time is in 100 ns units.
		Angle	  := cStartAngle;
		AngleStep := (cEndAngle - cStartAngle) * UDINT_TO_LREAL(_TaskInfo[GETCURTASKINDEXEX()].CycleTime) * 1.0E-7 / cArcTime;
	END_IF

	Mover.BTN	  := cBtn;
	Mover.SetXPos := cCenterX + cRadius * COS(Angle);
	Mover.SetYPos := cCenterY + cRadius * SIN(Angle);

	IF Angle >= cEndAngle THEN
		// Finished. BTN stays 1234 for this cycle so the end point is still logged.
		Active := FALSE;
	ELSE
		Angle := MIN(Angle + AngleStep, cEndAngle);
	END_IF
ELSE
	// Inactive: only BTN drops (stops the logger). Hold the last position so the
	// one sample published after the condition clears does not spike to 0/0.
	Mover.BTN := 0;
END_IF

ActiveLast := Active;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>